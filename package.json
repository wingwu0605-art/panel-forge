{
  "name": "panel-forge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PanelForge 分镜坊 — 中日韩漫画分镜模板库 + 镂空填充网页编辑器 + 剧情匹配 API",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/validate.mjs && node scripts/test-units.mjs && node scripts/test-api.mjs",
    "test:units": "node scripts/test-units.mjs",
    "test:ai": "node scripts/test-llm-mock.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "test:perf": "node scripts/perf-bench.mjs",
    "build:static": "node scripts/build-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "dump": "node scripts/dump-templates.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
